# COPR secureblue/packages — fournit hardened_malloc (absent des dépôts Fedora).
# Utilisé AU BUILD par rpm-ostree/dnf (les postes ne tirent pas de RPM au runtime :
# image mode). Modèle : https://github.com/secureblue/secureblue/blob/live/files/system/etc/yum.repos.d/secureblue-packages-fedora.repo
# (secureblue épingle la clé GPG dans l'image ; amélioration possible — cf. hardening/README.md)
# Revert : hardening/reverts/revert_hardened_malloc.sh
[copr:copr.fedorainfracloud.org:secureblue:packages]
name=Copr repo for packages owned by secureblue
baseurl=https://download.copr.fedorainfracloud.org/results/secureblue/packages/fedora-$releasever-$basearch/
type=rpm-md
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/secureblue/packages/pubkey.gpg
repo_gpgcheck=0
skip_if_unavailable=False
enabled=1
