# =============================================================================
#  Containerfile — image DESKTOP « szh-silverblue-desktop » (image mode / bootc).
#
#  Modèle : base Silverblue → COPY noyau commun (common/) + fichiers desktop →
#  RUN build.sh (layering RPM + services + kDrive + commit ostree) → lint bootc.
#
#  ⚠️ Le contexte de build est la RACINE du dépôt (pour voir common/ ET images/).
#  Build local :
#    podman build -f images/szh-silverblue-desktop/Containerfile -t szh-silverblue-desktop .
#  Avec kDrive (motif d'URL %VERSION%) :
#    podman build -f images/szh-silverblue-desktop/Containerfile \
#       --build-arg KDRIVE_URL="https://.../kDrive-%VERSION%-amd64.AppImage" \
#       -t szh-silverblue-desktop .
# =============================================================================

# Base Silverblue. Le tag est piloté par Renovate (voir .github/renovate.json5).
ARG BASE_IMAGE=quay.io/fedora/fedora-silverblue
ARG FEDORA_VERSION=44
FROM ${BASE_IMAGE}:${FEDORA_VERSION}

# --- kDrive (optionnel) ------------------------------------------------------
# KDRIVE_VERSION : version COMPLÈTE du nom de l'AppImage Infomaniak (4 segments, ex.
#   3.8.2.6 ; le 4e = build interne, absent des tags GitHub → MAJ MANUELLE, voir docs/04).
# KDRIVE_URL : MOTIF d'URL avec %VERSION% (vars.KDRIVE_URL en CI). Vide → kDrive omis.
ARG KDRIVE_VERSION=3.8.2.6
ARG KDRIVE_URL=""

# 1. Noyau COMMUN (fragments partagés par toute la flotte : durcissement, signatures).
COPY common/system_files/ /
# 2. Fichiers propres au desktop.
COPY images/szh-silverblue-desktop/system_files/ /
# 3. Helpers communs + scripts de build de l'image.
COPY common/build/ /tmp/common/build/
COPY images/szh-silverblue-desktop/build.sh images/szh-silverblue-desktop/install-kdrive.sh /tmp/build/

# Couche système + services + intégration kDrive + commit ostree (dans build.sh).
RUN KDRIVE_URL="${KDRIVE_URL}" KDRIVE_VERSION="${KDRIVE_VERSION}" \
    bash /tmp/build/build.sh

# Vérifie que l'image respecte les invariants bootc (échoue le build si non).
RUN bootc container lint
