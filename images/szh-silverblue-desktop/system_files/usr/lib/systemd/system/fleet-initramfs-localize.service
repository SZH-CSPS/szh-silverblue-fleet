# Garantit la régénération LOCALE de l'initramfs, pour embarquer le keymap clavier
# suisse (/etc/vconsole.conf → invite LUKS/PIN en suisse, pas en QWERTY US).
# On NE régénère PAS dans le build conteneur (dracut y échoue) : on délègue à rpm-ostree
# côté poste, où la régénération est fiable (validé).
#
# À CHAQUE boot (pas de stamp — leçon apprise) : le flag de régénération est stocké dans
# l'origin du DÉPLOIEMENT et ne survit PAS à un `bootc switch`/rollback ; un stamp dans
# /var, lui, persiste → l'ancien couple stamp+Condition bloquait toute ré-activation après
# un switch (keymap US de retour à l'invite LUKS). Désormais : vérification à chaque boot
# (grep, ~0 coût) ; ré-activation seulement si nécessaire.
#
# Effet d'une (ré)activation : crée un nouveau déploiement avec l'initramfs régénéré →
# appliqué au PROCHAIN redémarrage (pas de reboot automatique).
[Unit]
Description=Régénération locale de l'initramfs (clavier suisse à l'invite LUKS)
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/bin/bash -c 'rpm-ostree initramfs 2>/dev/null | grep -qi "enabled" || rpm-ostree initramfs --enable'

[Install]
WantedBy=multi-user.target
